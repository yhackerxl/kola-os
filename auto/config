#!/bin/sh
set -e

# Kola OS v0.1 - live-build configuration
# Called by `lb config` (live-build sources this file itself).

# Mirror: measured by env/mirror.sh (cached in .mirror), overridable via env.
if [ -n "${KOLA_MIRROR:-}" ]; then
	MIRROR="${KOLA_MIRROR}"
elif [ -f .mirror ]; then
	MIRROR=$(awk '{print $1}' .mirror)
else
	MIRROR=http://ftp.nl.debian.org/debian
fi

# LB_MIRROR_* only describes the mirror recorded *inside* the image. The
# bootstrap stage actually debootstraps from LB_PARENT_MIRROR_*, which live-build
# defaults to deb.debian.org and, worse, persists in config/bootstrap across
# `lb config` runs. Both sets must be passed, or the build silently ignores the
# measured mirror and crawls on the CDN.
lb config noauto \
	--mode debian \
	--distribution bookworm \
	--architectures amd64 \
	--linux-flavours amd64 \
	--mirror-bootstrap "${MIRROR}" \
	--mirror-chroot "${MIRROR}" \
	--mirror-binary "${MIRROR}" \
	--parent-mirror-bootstrap "${MIRROR}" \
	--parent-mirror-chroot "${MIRROR}" \
	--parent-mirror-binary "${MIRROR}" \
	--binary-images iso-hybrid \
	--bootloader grub-efi \
	--bootappend-live "boot=live components quiet loglevel=3 vt.global_cursor_default=0 username=kola hostname=kola locales=en_US.UTF-8 keyboard-layouts=us keyboard-model=pc105 timezone=Africa/Dar_es_Salaam" \
	--apt-recommends false \
	--apt-indices false \
	--cache-stages none \
	--apt-options "--yes --no-install-recommends -o Acquire::Retries=5" \
	--archive-areas "main contrib non-free-firmware" \
	--debian-installer none \
	--memtest none \
	--firmware-chroot true \
	--firmware-binary false \
	--uefi-secure-boot disable \
	--security false \
	--updates false \
	--compression xz \
	--initramfs-compression gzip \
	--checksums sha256 \
	--iso-application "Kola OS" \
	--iso-preparer "Kola OS Project" \
	--iso-publisher "Kola OS Project" \
	--iso-volume "KOLA_OS_0_1" \
	"$@"
