#!/bin/sh
set -e

# Kola OS v0.1 - live-build configuration
# Called by `lb config` (live-build sources this file itself).

lb config noauto \
	--mode debian \
	--distribution bookworm \
	--architectures amd64 \
	--linux-flavours amd64 \
	--mirror-bootstrap http://ftp.nl.debian.org/debian \
	--mirror-chroot http://ftp.nl.debian.org/debian \
	--mirror-binary http://ftp.nl.debian.org/debian \
	--binary-images iso-hybrid \
	--bootloader grub-efi \
	--bootappend-live "boot=live components quiet loglevel=3 vt.global_cursor_default=0 username=kola hostname=kola locales=en_US.UTF-8 keyboard-layouts=us keyboard-model=pc105 timezone=Africa/Dar_es_Salaam" \
	--apt-recommends false \
	--apt-indices false \
	--cache-stages none \
	--apt-options "--yes --no-install-recommends -o Acquire::Retries=5" \
	--archive-areas "main contrib non-free-firmware" \
	--debian-installer none \
	--memtest none \
	--firmware-chroot true \
	--firmware-binary false \
	--uefi-secure-boot disable \
	--security false \
	--updates false \
	--compression xz \
	--initramfs-compression gzip \
	--checksums sha256 \
	--iso-application "Kola OS" \
	--iso-preparer "Kola OS Project" \
	--iso-publisher "Kola OS Project" \
	--iso-volume "KOLA_OS_0_1" \
	"$@"
