# live-build state
config/binary
config/bootstrap
config/chroot
config/chroot_apt
config/chroot_local-includes
config/common
config/source
config/bootstrap.log
config/binary_rootfs
config/chroot_local-hooks
config/hooks/*.hook.binary.tmp
*.iso
*.iso.zsync
*.iso.sha256
*.iso.md5
*.iso.sha512
*.log
build-*.log

# build artefacts
binary/
cache/
.tmp/
chroot/
.build/
.lock
logs/

# live-build injects root-owned absolute symlinks to its own default hooks on
# every `lb config`. They are machine-specific and must never be committed.
/config/hooks/normal/[1-9][0-9][0-9][0-9]-*.hook.chroot
/config/hooks/live/*.hook.chroot
/config/hooks/*/*.hook.binary

# generated by lb config, content varies per live-build version
/config/package-lists/live.list.chroot
