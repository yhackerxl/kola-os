#!/bin/sh
# Kola OS: strip weight and disable daemons we do not ship a UI for.
set -eu

# No printing, no discovery, no bluetooth, no modem stack in v0.1.
for unit in cups cups-browsed avahi-daemon bluetooth ModemManager \
	apt-daily.timer apt-daily-upgrade.timer; do
	systemctl disable "${unit}" 2>/dev/null || true
done

# Keep clock sane: legacy CMOS batteries are dead, TLS depends on it.
systemctl enable systemd-timesyncd 2>/dev/null || true

rm -rf /var/lib/apt/lists/* /var/cache/apt/* /var/lib/apt/lists/partial
rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/*
find /var/log -type f -exec truncate -s 0 {} + 2>/dev/null || true

exit 0
