# Kola OS tint2 - minimal panel: launcher, taskbar, RAM meter, clock, systray
panel_monitor = all
panel_position = bottom center horizontal
panel_size = 100% 26
panel_margin = 0 0
panel_padding = 2 0 2
panel_background_id = 0
wm_menu = 0
panel_dock = 0
panel_layer = bottom
panel_taskbar_mode = 1

taskbar_mode = single_desktop
taskbar_padding = 2 0 2
taskbar_background_id = 0
taskbar_name = 0
taskbar_distribute_size = 0
taskbar_sort_order = none
task_align = left

launcher_padding = 4 0 4
launcher_background_id = 0
launcher_icon_size = 0
launcher_item_app = /usr/share/applications/lxterminal.desktop
launcher_item_app = /usr/share/applications/pcmanfm.desktop
launcher_item_app = /usr/share/applications/epiphany.desktop
launcher_item_app = /usr/share/applications/geany.desktop

systray_padding = 4 2 4
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 18

time1_format = %H:%M
time1_font = sans 9
time2_format = %a %d %b
time2_font = sans 7
clock_font_color = #d8d8d8 100
clock_padding = 6 0
clock_background_id = 0

execp = new
execp_command = free -m | awk 'NR==2{printf " RAM %d%%", $3*100/$2}'
execp_interval = 5
execp_has_icon = 0
execp_font = sans 8
execp_font_color = #d8d8d8 100
execp_background_id = 0
execp_padding = 4 0 8
execp_tooltip = Memory in use

background_id = 0
rounded = 0
border_width = 0
background_color = #1c1c1c 92
border_color = #2c2c2c 100
